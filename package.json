    "polymarket",
    "scanner",
    "eurovision"
  ],
  "license": "MIT",
  "devDependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "@walletconnect/sign-client": "^2.23.9",
    "ethers": "^6.16.0",
    "qrcode-terminal": "^0.12.0"
  }
}
