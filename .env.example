# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects the /slugs endpoint (add/remove tracked events).
# Set a strong secret before deploying publicly. Leave blank for local dev.
ADMIN_TOKEN=

# ── Polymarket CLOB API (open orders only) ────────────────────────────────────
# Optional. Generate via: https://docs.polymarket.com/developers/CLOB/authentication
# Leave all three blank to disable open-order fetching.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# ── Server ────────────────────────────────────────────────────────────────────
# Overrides the port in bot.config.json (optional)
# BOT_PORT=3001
